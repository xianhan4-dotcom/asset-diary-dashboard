# BSC RPC endpoint. Public RPC URLs are supported; a private provider is more reliable.
ASSET_DIARY_BSC_RPC_HTTP=

# Optional market data key.
ASSET_DIARY_COINGECKO_API_KEY=

# Telegram delivery.
ASSET_DIARY_TELEGRAM_BOT_TOKEN=
ASSET_DIARY_TELEGRAM_CHAT_ID=

# Exchange credentials must have read-only permissions.
ASSET_DIARY_BINANCE_API_KEY=
ASSET_DIARY_BINANCE_API_SECRET=
ASSET_DIARY_OKX_API_KEY=
ASSET_DIARY_OKX_API_SECRET=
ASSET_DIARY_OKX_API_PASSPHRASE=
